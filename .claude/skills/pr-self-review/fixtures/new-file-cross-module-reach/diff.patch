--- /dev/null
+++ b/server/src/modules/reviews/digest-service.ts
@@ -0,0 +1,14 @@
+import { AgentsRepository } from '../agents/repository.js';
+import type { ReviewRepository } from './repository.js';
+
+export class DigestService {
+  constructor(
+    private readonly reviews: ReviewRepository,
+    private readonly agents = new AgentsRepository(),
+  ) {}
+
+  async digest(workspaceId: string, runId: string) {
+    const run = await this.reviews.findRun(workspaceId, runId);
+    const agent = await this.agents.byId(workspaceId, run.agentId);
+    return { run, agentName: agent.name };
+  }
+}
